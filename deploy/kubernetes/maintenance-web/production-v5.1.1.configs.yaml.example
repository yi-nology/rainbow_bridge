backup:
  distributed:
    enabled: true
    web_enabled: true
    instance_id: REPLACE_NEW_PRODUCTION_UUID
    control_dsn: REPLACE_PRIVATE_GUARD_DSN
    auth_dsn: REPLACE_PRIVATE_AUTH_DSN
    generation: 1
    session_generation: 1
---
# console-config/console.yaml; independent control/auth connections only.
